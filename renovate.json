{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "constraints": {
    "node": "^22",
    "npm": "^12.0.0"
  },
  "packageRules": [
    {
      "description": "Angular 21 admite zone.js ~0.15 || ~0.16 (peer de @angular/core); revisar junto con Angular 22",
      "matchPackageNames": [
        "zone.js"
      ],
      "allowedVersions": "<0.17.0"
    },
    {
      "description": "Angular, su CLI y angular-eslint se quedan en 21 hasta migrar con ng update (una versión mayor por vez)",
      "matchPackageNames": [
        "@angular/**",
        "@angular-devkit/**",
        "@schematics/angular",
        "angular-eslint",
        "@angular-eslint/**"
      ],
      "allowedVersions": "<22.0.0"
    },
    {
      "description": "Angular 21 admite TypeScript >=5.9 <6.1",
      "matchPackageNames": [
        "typescript"
      ],
      "allowedVersions": "<6.1.0"
    },
    {
      "description": "karma-jasmine 5.1 (la última) depende de jasmine-core ^4; jasmine-core 7 rompe Karma. Subirlo al cambiar de runner de tests",
      "matchPackageNames": [
        "jasmine-core"
      ],
      "allowedVersions": "<6.0.0"
    }
  ]
}
